{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blot command v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "commandId",
    "type",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "project.create",
        "project.archive",
        "project.delete",
        "conversation.create",
        "conversation.send_message",
        "generation.cancel",
        "generation.retry",
        "memory.save",
        "memory.delete",
        "provider.settings",
        "device.pair",
        "device.approve",
        "device.revoke",
        "budget.increase",
        "profile.save",
        "run.create",
        "run.plan.approve",
        "run.pause",
        "run.resume",
        "run.stop",
        "run.steer",
        "run.accept",
        "task.retry",
        "permission.grant",
        "permission.deny",
        "permission.revoke",
        "user.answer",
        "skill.save",
        "skill.delete",
        "automation.save",
        "automation.run_now",
        "automation.delete",
        "git.prepare_commit",
        "git.prepare_push",
        "git.execute",
        "git.reconcile",
        "tool.reconcile",
        "tool.abandon",
        "legacy.adopt",
        "project.access",
        "conversation.update",
        "message.delete"
      ]
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "expectedVersion": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
