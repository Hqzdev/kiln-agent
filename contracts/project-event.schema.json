{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blot persisted event v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "seq",
    "eventId",
    "projectId",
    "type",
    "occurredAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "type": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {}
  },
  "additionalProperties": false
}
