{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.local/contracts/project-event",
  "type": "object",
  "required": [
    "eventId",
    "projectId",
    "runId",
    "entityId",
    "schemaVersion",
    "seq",
    "entityVersion",
    "occurredAt",
    "type",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "schemaVersion": {
      "const": 1
    },
    "seq": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "entityVersion": {
      "type": "integer",
      "minimum": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
